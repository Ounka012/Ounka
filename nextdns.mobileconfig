<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- ផ្នែកកំណត់ Profile ទាំងមូល -->
    <key>PayloadDisplayName</key>
    <string>Cloudflare Fast DNS (Game Booster)</string>
    <key>PayloadDescription</key>
    <string>ជួយកាត់បន្ថយ Ping និង Lag សម្រាប់ការលេងហ្គេម និងអ៊ីនធឺណិតលឿនជាងមុន</string>
    <key>PayloadIdentifier</key>
    <string>com.cloudflare.ios.dns.profile</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadUUID</key>
    <string>11111111-2222-3333-4444-555555555555</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>

    <!-- ផ្នែកកំណត់ DNS ដែលនឹងដំណើរការលើទូរស័ព្ទ -->
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.cloudflare.ios.dns.settings</string>
            <key>PayloadUUID</key>
            <string>66666666-7777-8888-9999-aaaaaaaaaa</string>
            <key>PayloadDisplayName</key>
            <string>Cloudflare 1.1.1.1 (លឿនជាងគេ)</string>
            <key>PayloadDescription</key>
            <string>Encrypted DNS សម្រាប់បង្កើនល្បឿនបណ្តាញ</string>
            
            <!-- ការកំណត់ DNS ពិតប្រាកដ -->
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <key>ServerURL</key>
                <string>https://cloudflare-dns.com/dns-query</string>
                <key>ServerAddresses</key>
                <array>
                    <string>1.1.1.1</string>
                    <string>1.0.0.1</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>