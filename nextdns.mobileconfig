<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>NextDNS Boost Profile</string>
    <key>PayloadDescription</key>
    <string>កែលម្អល្បឿនអ៊ីនធឺណិត និងកាត់បន្ថយ Ping</string>
    <key>PayloadIdentifier</key>
    <string>io.nextdns.profile.main</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadUUID</key>
    <string>11111111-2222-3333-4444-555555555555</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>io.nextdns.profile.dns</string>
            <key>PayloadUUID</key>
            <string>66666666-7777-8888-9999-aaaaaaaaaa</string>
            <key>PayloadDisplayName</key>
            <string>NextDNS Encrypted</string>
            <key>PayloadDescription</key>
            <string>DNS Over HTTPS</string>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <!-- សំខាន់បំផុត៖ ត្រូវប្តូរ [ID] នេះជាលេខ ID គណនី NextDNS របស់អ្នក -->
                <key>ServerURL</key>
                <string>https://[ដាក់IDរបស់អ្នកនៅទីនេះ].dns.nextdns.io/dns-query</string>
                <key>ServerAddresses</key>
                <array>
                    <string>45.90.28.0</string>
                    <string>45.90.30.0</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>