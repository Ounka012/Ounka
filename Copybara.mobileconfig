<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>NextDNS</string>
    
    <key>PayloadDescription</key>
    <string>Configure NextDNS over HTTPS</string>
    
    <key>PayloadOrganization</key>
    <string>NextDNS</string>
    
    <key>PayloadIdentifier</key>
    <string>com.nextdns.profile</string>
    
    <key>PayloadUUID</key>
    <string>00000000-0000-0000-0000-000000000001</string>
    
    <key>PayloadVersion</key>
    <integer>1</integer>
    
    <key>PayloadType</key>
    <string>Configuration</string>
    
    <key>PayloadRemovalDisallowed</key>
    <false/>
    
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadDisplayName</key>
            <string>DNS Settings</string>
            
            <key>PayloadDescription</key>
            <string>Encrypted DNS using NextDNS</string>
            
            <key>PayloadIdentifier</key>
            <string>com.nextdns.profile.dns</string>
            
            <key>PayloadUUID</key>
            <string>00000000-0000-0000-0000-000000000002</string>
            
            <key>PayloadVersion</key>
            <integer>1</integer>
            
            <key>PayloadType</key>
            <string>com.apple.dnsSettings</string>
            
            <key>DNSSettings</key>
            <dict>
                <!-- ប្រើ DNS over HTTPS -->
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                
                <!-- URL របស់ NextDNS (ប្តូរ YOUR_PROFILE_ID ទៅជា ID របស់អ្នក) -->
                <key>ServerURL</key>
                <string>https://dns.nextdns.io/YOUR_PROFILE_ID</string>
                
                <!-- Server Addresses (ស្រេចចិត្ត) -->
                <key>ServerAddresses</key>
                <array>
                    <string>45.90.28.0</string>
                    <string>45.90.30.0</string>
                </array>
            </dict>
        </dict>
    </array>
</dict>
</plist>
