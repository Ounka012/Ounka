<plist version="1.0">
<dict>
    <key>PayloadDisplayName</key>
    <string>DNS-ounka </string>
    <key>PayloadDescription</key>
    <string>Configures Encrypted DNS over HTTPS using DNS-ounka</string>
    <key>PayloadIdentifier</key>
    <string>com.nextdns.mobileconfig</string>
    <key>PayloadUUID</key>
    <string>9F01A4B0-4A3C-43E2-9E8D-1A2B3C4D5E6F</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadDisplayName</key>
            <string>DNS Settings</string>
            <key>PayloadDescription</key>
            <string>Configures DNS settings</string>
            <key>PayloadIdentifier</key>
            <string>com.apple.dnsSettings.managed.nextdns</string>
            <key>PayloadUUID</key>
            <string>1A2B3C4D-5E6F-7A8B-9C0D-1E2F3A4B5C6D</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadType</key>
